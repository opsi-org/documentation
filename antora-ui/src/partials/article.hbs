<article class="doc">
{{#with page.title}}
<h1 class="page">{{{this}}}</h1>
{{/with}}
{{#with page.attributes.ai-translation-warning}}
<div class="admonitionblock warning" role="note" aria-label="Avertissement concernant la traduction">
	<table>
		<tr>
			<td class="icon"><i class="fa icon-warning" title="Avertissement"></i></td>
			<td class="content">{{this}}</td>
		</tr>
	</table>
</div>
{{/with}}
{{{page.contents}}}
{{> pagination}}
</article>
